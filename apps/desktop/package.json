{
  "name": "coredesk-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "allowScripts": [
    "esbuild"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "node electron/start.mjs",
    "desktop:dev": "node electron/start.mjs --mode dev",
    "check:electron": "node electron/start.mjs",
    "check:routes": "node verify-app.mjs",
    "check:thread": "node verify-thread.mjs",
    "check:interaction": "node verify-interaction.mjs",
    "check:layout": "node measure-layout.mjs",
    "shots:auth": "node shoot-auth.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
