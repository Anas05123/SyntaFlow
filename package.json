{
  "name": "coredesk-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoreDesk — The Local-First Operating System for Solo Agency Principals",
  "scripts": {
    "desktop": "node apps/desktop/electron/start.mjs",
    "desktop:dev": "node apps/desktop/electron/start.mjs --mode dev",
    "check:routes": "node apps/desktop/verify-app.mjs",
    "build": "pnpm --filter coredesk-app build",
    "lint": "pnpm --filter coredesk-app lint",
    "test": "vitest run",
    "test:security": "vitest run tests/security"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "typescript": "^5.9.2",
    "vite": "5.4.19",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "electron": "^44.2.0"
  }
}
