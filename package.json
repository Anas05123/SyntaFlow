{
  "name": "project-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Agency OS repository foundation for Project Atlas.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @atlas/desktop dev",
    "build": "pnpm -r build",
    "package": "pnpm --filter @atlas/desktop package",
    "make": "pnpm --filter @atlas/desktop make",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm test:security",
    "test:unit": "pnpm -r test",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:security": "vitest run tests/security",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:status": "node scripts/database/status.mjs",
    "db:backup": "node scripts/database/backup.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "5.4.19",
    "vitest": "^3.2.4"
  }
}
